{
  "name": "quire-markdown-reader",
  "version": "0.0.8",
  "description": "An open-source, read-only Markdown reader and local document workspace for browsers.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "keywords": [
    "browser-extension",
    "markdown",
    "reader",
    "wxt"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "npm run dev:chrome",
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip": "npm run zip:chrome && npm run zip:firefox",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "package": "npm run build && npm run zip && node scripts/verify-packages.mjs",
    "package:verify": "node scripts/verify-packages.mjs",
    "source:verify": "node scripts/verify-source-build.mjs",
    "release:verify": "node scripts/verify-release-version.mjs",
    "store:assets": "node scripts/capture-store-assets.mjs",
    "store:verify": "node scripts/verify-store-assets.mjs",
    "bundle:verify": "node scripts/verify-bundle-budget.mjs",
    "brand:icons": "node scripts/generate-icons.mjs",
    "security:verify": "npm audit --registry=https://registry.npmjs.org --audit-level=moderate",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"{src,e2e,scripts,.github}/**/*.{ts,tsx,js,mjs,yml,yaml}\" \"*.{json,md,ts}\"",
    "format:check": "prettier --check \"{src,e2e,scripts,.github}/**/*.{ts,tsx,js,mjs,yml,yaml}\" \"*.{json,md,ts}\"",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && npm run test:e2e:chromium && npm run test:e2e:firefox:context",
    "test:e2e:chromium": "playwright test e2e/chromium.spec.ts",
    "test:e2e:firefox": "node e2e/firefox-installed.mjs",
    "test:e2e:firefox:context": "FIREFOX_SKIP_SHORTCUT=1 node e2e/firefox-installed.mjs",
    "test:e2e:firefox:native": "FIREFOX_HEADED=1 FIREFOX_NATIVE_INPUT=1 FIREFOX_SKIP_CONTEXT=1 node e2e/firefox-installed.mjs",
    "test:visual": "npm run build:chrome && playwright test e2e/visual.spec.ts",
    "test:visual:update": "npm run build:chrome && playwright test e2e/visual.spec.ts --update-snapshots"
  },
  "dependencies": {
    "@mdit/plugin-abbr": "^1.0.2",
    "@mdit/plugin-container": "^1.0.2",
    "@mdit/plugin-footnote": "^1.0.2",
    "@mdit/plugin-tasklist": "^1.0.2",
    "@wxt-dev/module-react": "^1.2.2",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.3.1",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.17.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "^0.1.2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "selenium-webdriver": "^4.48.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.4",
    "wxt": "^0.21.4"
  }
}
